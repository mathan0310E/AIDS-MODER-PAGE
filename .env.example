# Copy this file to .env.local and fill in the values for your deployment.
# All values are optional for local development unless noted.

# Public site URL used for SEO metadata, sitemap and Open Graph tags.
# Update this to your production domain (e.g. https://aids.skpec.edu.in).
NEXT_PUBLIC_SITE_URL=https://aids.skpec.edu.in

# Department contact — used by the contact API route and the footer.
CONTACT_DELIVER_TO=aids@skpec.edu.in

# ---------- Auth.js (Google OAuth admin login) ----------
# Generate with: openssl rand -base64 33
AUTH_SECRET=

# Create at Google Cloud Console → Credentials → OAuth client ID (see ADMIN-SETUP.md)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated Google emails allowed to enter /admin (allowlist).
ADMIN_EMAILS=

# Set to "true" ONLY in local development to allow any Google account.
# NEVER set this in production.
ADMIN_DEV_BYPASS=false

# ---------- GitHub (content commits from the admin panel) ----------
# Fine-grained PAT with "Contents: Read & Write" on your repo.
GITHUB_TOKEN=
GITHUB_OWNER=your-github-username
GITHUB_REPO=your-repo-name
GITHUB_BRANCH=main

# Optional: Resend / SendGrid API key when you wire up real email delivery
# in src/app/api/contact/route.ts (the deliverEnquiry function).
# RESEND_API_KEY=
# SENDGRID_API_KEY=
